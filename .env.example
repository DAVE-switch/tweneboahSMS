# Copy this file to .env and put the Neon pooled URL in DATABASE_URL.
# Use the direct (unpooled) URL as DATABASE_URL_UNPOOLED only when running migrations/imports.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require

# Vercel Node.js function pool size. Keep small to protect the database connection limit.
PG_POOL_SIZE=3

# Optional; the hosting provider usually supplies this value.
PORT=3002
