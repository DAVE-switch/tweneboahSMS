# Copy this file to .env and replace the placeholders with credentials from your MySQL host.
# Either set a MySQL URL (URL-encode special characters in username/password)...
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME

# ...or use the TIDB_* variables provided by the TiDB Cloud Vercel integration.
# TIDB_HOST=your-cluster.example.com
# TIDB_PORT=4000
# TIDB_USER=your-user
# TIDB_PASSWORD=your-password
# TIDB_DATABASE=your-database

# Set true for a managed database that requires TLS (most hosted databases do).
MYSQL_SSL=true

# Keep low because Vercel can run multiple function instances at once.
MYSQL_CONNECTION_LIMIT=3

# Optional; the hosting provider usually supplies this value.
PORT=3002
